# Copy to .env and edit:  cp .env.example .env
# None of these are required for the default (VADER) run.

# ---- Data ----
# Path to the raw dataset (default: data/raw/test.csv)
RAW_DATA_PATH=data/raw/test.csv

# ---- Sentiment labeling backend ----
# vader (default, offline) | transformer (Hugging Face) | llm (API)
SENTIMENT_METHOD=vader

# VADER compound-score thresholds
VADER_POS_THRESHOLD=0.05
VADER_NEG_THRESHOLD=-0.05

# Hugging Face model used when SENTIMENT_METHOD=transformer
TRANSFORMER_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# ---- LLM labeling (SENTIMENT_METHOD=llm) ----
# Provider: anthropic | openai
LLM_PROVIDER=anthropic
# Model name exactly as your provider's API expects it,
# e.g. claude-haiku-5-5 (Anthropic) or gpt-4o-mini (OpenAI)
LLM_MODEL=claude-haiku-5-5
# Only the key for the provider you chose is needed. NEVER commit or zip your real .env
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
# Parallel API requests; lower it (e.g. 2) if you hit rate-limit errors
LLM_WORKERS=8
